# Variables du Hub (copier en hub/.env, jamais commité). Aucune valeur réelle ici.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# openssl rand -hex 32
HUB_ADMIN_TOKEN=
PUBLIC_BASE_URL=https://hub.example.org
# HUB_RATE_READ=600
# HUB_RATE_ADMIN=60
# HUB_MIGRATE=1
# Phase 3 : comptes (Supabase Auth), rôles, signature des versions
SUPABASE_URL=https://supabase.example.org
# Clé anonyme (publique) : lien magique de la page /device ; sans elle, connexion GitHub seulement
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=
# HUB_ADMINS=<e-mails ou ids Supabase, séparés par des virgules>
# HUB_MODERATORS=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HUB_SIGNING_KEY=
# HUB_RATE_WRITE=30
