# Copier en .env puis ajuster. Ne jamais committer le fichier .env.

# Base SQLite locale (le dossier est créé au besoin)
DATABASE_PATH=./data/personas.db

# Backend claude-cli : CLI `claude` connectée à un abonnement Claude (usage personnel)
# Chemin complet si `claude` n'est pas dans le PATH (ex. ~/.local/bin/claude)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_CONCURRENCY=2
CLAUDE_CLI_TIMEOUT_MS=300000

# Backend ollama : serveur Ollama local (ou joint par un tunnel SSH vers une autre machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=32768
# Plafonnée à 2 dans le code quoi qu'on mette ici
OLLAMA_CONCURRENCY=2
OLLAMA_TIMEOUT_MS=600000

# Langue des messages de la CLI : fr ou en. Sans valeur, déduite de LC_ALL / LC_MESSAGES / LANG (fr* → fr, sinon en).
# Language of the CLI messages: fr or en. If unset, taken from LC_ALL / LC_MESSAGES / LANG (fr* → fr, otherwise en).
# PERSONAS_LANG=fr
