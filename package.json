{
  "name": "personas",
  "version": "1.0.0",
  "description": "Simulateur de personas synthétiques pour tester des idées, des business models et des prix.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "personas": "dist/cli/main.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "drizzle/",
    "packs/**/*.json",
    "modules/*/module.yaml",
    "modules/_archive/entrepreneuriat-tech/module.yaml",
    "calibration/payment-v3.json",
    "pricing/models.json",
    "pricing/reference-usage.json",
    "docs/modules.md",
    "examples/sg/recipe-app.yaml",
    "examples/meal-planner.json",
    "examples/meal-planner-numerique.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "engine:check": "tsx src/cli/engine-check.ts",
    "engine:profile": "tsx src/cli/engine-profile.ts",
    "engine:key": "tsx src/cli/engine-key.ts",
    "personas:generate": "tsx src/cli/personas-generate.ts",
    "personas:narrate": "tsx src/cli/personas-narrate.ts",
    "personas:validate": "tsx src/cli/personas-validate.ts",
    "personas:show": "tsx src/cli/personas-show.ts",
    "personas:migrate-modules": "tsx src/cli/personas-migrate-modules.ts",
    "population:draw": "tsx src/cli/population-draw.ts",
    "module:propose": "tsx src/cli/module-propose.ts",
    "module:revise": "tsx src/cli/module-revise.ts",
    "module:preview": "tsx src/cli/module-preview.ts",
    "module:accept": "tsx src/cli/module-accept.ts",
    "project:create": "tsx src/cli/project-create.ts",
    "project:list": "tsx src/cli/project-list.ts",
    "study:create": "tsx src/cli/study-create.ts",
    "study:run": "tsx src/cli/study-run.ts",
    "study:estimate": "tsx src/cli/study-estimate.ts",
    "pricing:reference": "tsx src/cli/pricing-reference.ts",
    "study:summary": "tsx src/cli/study-summary.ts",
    "study:list": "tsx src/cli/study-list.ts",
    "study:compare": "tsx src/cli/study-compare.ts",
    "dev:web": "tsx watch --clear-screen=false src/web/dev.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:web && tsx scripts/build.ts",
    "prepack": "npm run build",
    "start:web": "tsx src/web/server.ts",
    "hosted:start": "tsx src/hosted/server.ts",
    "hosted:reactivate": "tsx src/cli/hosted-reactivate.ts",
    "triage:validate": "tsx src/cli/triage-validate.ts",
    "target:preview": "tsx src/cli/target-preview.ts",
    "target:suggest": "tsx src/cli/target-suggest.ts",
    "study:drivers": "tsx src/cli/study-drivers.ts",
    "study:recode": "tsx src/cli/study-recode.ts",
    "project:suggest-protocol": "tsx src/cli/project-suggest-protocol.ts",
    "study:recommend": "tsx src/cli/study-recommend.ts",
    "project:neutralize-pitch": "tsx src/cli/project-neutralize-pitch.ts",
    "calibration:fit": "tsx src/cli/calibration-fit.ts",
    "mcp": "tsx src/mcp/main.ts",
    "hub:dev": "tsx watch hub/src/server.ts",
    "hub:start": "tsx hub/src/server.ts",
    "hub:migrate": "tsx hub/scripts/migrate.ts",
    "hub:db:generate": "drizzle-kit generate --config hub/drizzle.config.ts",
    "hub:seed": "tsx hub/scripts/seed-official.ts",
    "hub:demo": "tsx hub/scripts/dev-pglite.ts",
    "hub:test": "vitest run hub/test",
    "hub:search": "tsx src/cli/hub-search.ts",
    "hub:pull": "tsx src/cli/hub-pull.ts",
    "hub:sync": "tsx src/cli/hub-sync.ts",
    "hub:publish": "tsx src/cli/hub-publish.ts",
    "hub:lock": "tsx src/cli/hub-lock.ts",
    "hub:login": "tsx src/cli/hub-login.ts",
    "hub:logout": "tsx src/cli/hub-logout.ts",
    "hub:whoami": "tsx src/cli/hub-whoami.ts",
    "hub:fork": "tsx src/cli/hub-fork.ts",
    "hub:star": "tsx src/cli/hub-star.ts",
    "hub:unstar": "tsx src/cli/hub-unstar.ts",
    "hub:review": "tsx src/cli/hub-review.ts",
    "hub:report": "tsx src/cli/hub-report.ts",
    "hub:telemetry": "tsx src/cli/hub-telemetry.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/keyring": "2.1.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wouter": "^3.13.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": ""
}
