{
  "name": "personas",
  "version": "1.0.0",
  "description": "Simulateur de personas synthétiques pour tester des idées, des business models et des prix.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "engine:check": "tsx src/cli/engine-check.ts",
    "personas:generate": "tsx src/cli/personas-generate.ts",
    "personas:narrate": "tsx src/cli/personas-narrate.ts",
    "personas:validate": "tsx src/cli/personas-validate.ts",
    "personas:show": "tsx src/cli/personas-show.ts",
    "personas:migrate-modules": "tsx src/cli/personas-migrate-modules.ts",
    "population:draw": "tsx src/cli/population-draw.ts",
    "module:propose": "tsx src/cli/module-propose.ts",
    "module:revise": "tsx src/cli/module-revise.ts",
    "module:preview": "tsx src/cli/module-preview.ts",
    "module:accept": "tsx src/cli/module-accept.ts",
    "project:create": "tsx src/cli/project-create.ts",
    "project:list": "tsx src/cli/project-list.ts",
    "study:create": "tsx src/cli/study-create.ts",
    "study:run": "tsx src/cli/study-run.ts",
    "study:summary": "tsx src/cli/study-summary.ts",
    "study:list": "tsx src/cli/study-list.ts",
    "study:compare": "tsx src/cli/study-compare.ts",
    "dev:web": "tsx watch --clear-screen=false src/web/dev.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start:web": "tsx src/web/server.ts",
    "triage:validate": "tsx src/cli/triage-validate.ts",
    "target:preview": "tsx src/cli/target-preview.ts",
    "target:suggest": "tsx src/cli/target-suggest.ts",
    "study:drivers": "tsx src/cli/study-drivers.ts",
    "study:recode": "tsx src/cli/study-recode.ts",
    "project:suggest-protocol": "tsx src/cli/project-suggest-protocol.ts",
    "study:recommend": "tsx src/cli/study-recommend.ts",
    "project:neutralize-pitch": "tsx src/cli/project-neutralize-pitch.ts",
    "calibration:fit": "tsx src/cli/calibration-fit.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wouter": "^3.13.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": ""
}
